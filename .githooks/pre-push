#!/usr/bin/env bash
# pre-push — **원격의 커밋을 덮는 push 를 막고, 덮일 것을 먼저 적어 둔다**
#   〈2026-09-21 · D-251 · CLAUDE.md §12-61〉
#
# ★★★ 왜 있나: 2026-09-21 에 `git checkout -B <가지> origin/main` 으로 PR #89 의
#   커밋을 날린 뒤 force-push 가 **원격까지 덮었다.** 그때 잡아 준 것은 규칙이 아니라
#   우연히 세어 본 것이다 (§8-2). 그 규칙을 사람의 기억에서 내려 여기에 둔다.
#
# ★ 보통 push 는 **조용히 통과한다** — 막는 것은 「원격에 있는 커밋이 사라지는 push」뿐이다.
#   가르는 잣대 하나: 원격의 머리가 내가 미는 것의 **조상인가**.
#
# ★★ 막다른 길을 안 만든다 — 정말 덮으셔야 하면 `LP_FORCE_OK=1 git push …` 다.
#   그때도 **덮일 커밋 지문을 먼저 적어 둔다** (§6-3 ⑥).
#
# 켜는 법: npm run hooks:on   (git config core.hooksPath .githooks)

set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
GITDIR="$(git rev-parse --absolute-git-dir 2>/dev/null || echo .git)"
ZERO="0000000000000000000000000000000000000000"
BLOCK=0
LOST=""

while read -r LREF LSHA RREF RSHA; do
  [ -z "${LSHA:-}" ] && continue
  [ "$LSHA" = "$ZERO" ] && continue          # 가지를 지우는 push 는 여기서 안 본다
  [ "${RSHA:-$ZERO}" = "$ZERO" ] && continue # 새 가지 — 덮을 것이 없다
  # 원격 머리가 내 것의 조상이면 앞으로 감는 것이다 — 통과
  if git merge-base --is-ancestor "$RSHA" "$LSHA" 2>/dev/null; then continue; fi
  BLOCK=1
  LOST="${LOST}
--- ${RREF} (원격 ${RSHA}) 에서 덮이는 커밋 ---
$(git log --oneline "${LSHA}..${RSHA}" 2>/dev/null || echo '(못 읽었다 — 원격 커밋이 이 자리에 없다)')"
done

if [ "$BLOCK" = "0" ]; then exit 0; fi

# ★ 막기 «전에» 적어 둔다 — 뚫고 미셔도 되돌릴 길이 남는다
STAMP="$(date -u +%Y-%m-%dT%H-%M-%SZ)"
OUT="${GITDIR}/lp-safety/${STAMP}-force"
mkdir -p "$OUT" 2>/dev/null && printf '%s\n' "$LOST" > "${OUT}/OVERWRITTEN.txt" 2>/dev/null

echo ""
echo "  ❌ 이 push 는 **원격에 있는 커밋을 덮습니다.**"
echo "$LOST"
echo ""
echo "  ✓ 덮일 커밋 지문을 적어 뒀습니다 — ${OUT#$ROOT/}/OVERWRITTEN.txt"
echo ""
# ★★★ **지문으로는 «스쿼시»를 못 본다** 〈2026-09-21 · 실측 · 만든 날〉.
#   PR 의 커밋 여럿이 스쿼시로 한 커밋이 되면 **지문이 달라져** `git log main..<지문>` 이
#   「없다」고 한다 — 그런데 **내용은 이미 다 들어가 있다.** 그 글을 그대로 읽으면
#   「그 일이 사라진다」로 읽혀 **멀쩡한 push 를 접게 된다** (M-86 · §4.6 과 같은 결).
#   ★ 그래서 **내용을 견줘 먼저 말한다** — 잣대가 둘이면 둘 다 적는다 (§8).
# ★ 재는 것은 «덮일 커밋의 내용이 기준 가지에 있는가»다 — 「원격 가지와 HEAD 가
#   같은가」가 아니다(내 새 커밋 때문에 늘 다르다). 처음에 그렇게 재어 헛돌았다.
BASE="${LP_BASE:-main}"
SAME=""
for R in $(printf '%s\n' "$LOST" | sed -n 's/^--- \(.*\) (원격 .*/\1/p'); do
  RB="${R#refs/heads/}"
  if git diff --quiet "origin/${BASE}" "origin/${RB}" 2>/dev/null; then SAME="yes"; fi
done
if [ -n "$SAME" ]; then
  echo "  ✓ **내용은 이미 같습니다** — 덮어도 잃는 것이 없습니다."
  echo "    (스쿼시 병합이면 지문이 달라져도 내용은 들어가 있습니다)"
else
  echo "  ★ 먼저 보십시오: 그 커밋들의 **내용**이 이미 들어가 있습니까?"
  echo "    (재는 법: git diff --stat origin/main origin/<그 가지> — 비었으면 잃을 것이 없습니다)"
  echo "    ★★ **지문으로 재지 마십시오** — 스쿼시 병합이면 지문이 달라져"
  echo "       \`git log origin/main..<지문>\` 이 「없다」고 말합니다. 그 글은 틀린 곳을 가리킵니다."
fi
echo ""
echo "  ★★ 정말 덮으실 것이면: LP_FORCE_OK=1 git push …"
echo ""

# 커밋 안 된 변경도 함께 베껴 둔다 (있으면)
node "${ROOT}/im-agent/tools/push-guard.js" --dir "$ROOT" --save >/dev/null 2>&1 || true

if [ "${LP_FORCE_OK:-}" = "1" ]; then
  echo "  ★ LP_FORCE_OK=1 이라 그대로 밉니다."
  echo ""
  exit 0
fi
exit 1
