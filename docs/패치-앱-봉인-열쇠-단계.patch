+            v=$(printenv "$n" || true)
+            v=$(printf '%s' "$v" | tr -d '\r')
+            if [ -z "$v" ]; then SKIP="$SKIP $n"; continue; fi
+            { printf '<?php http_response_code(404); exit; ?>\n'; printf '%s\n' "$v"; } |               ssh -o BatchMode=yes -o ConnectTimeout=20 -i ~/.ssh/id_deploy "$NAS_USER@$NAS_HOST"                 "umask 022 && cat > '/volume1/web/${f}_key.store.php' && chmod 644 '/volume1/web/${f}_key.store.php' && : > '/volume1/web/${f}_key.txt' 2>/dev/null || true; echo WROTE ${f}"               && DONE="$DONE $n" || echo "::warning::${n} 봉인 파일을 못 놓았다 (ssh/권한)"
+          done
+          [ -n "$DONE" ] && echo "앱 열쇠 봉인:${DONE}" >> "$GITHUB_STEP_SUMMARY"
+          [ -n "$SKIP" ] && echo "::notice::Secret 이 비어 건너뜀:${SKIP} — Settings → Secrets 에 넣으면 다음 배포부터 앱에 실린다."
+          exit 0
