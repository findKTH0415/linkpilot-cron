{
  "name": "linkpilot-morning-card",
  "version": "1.0.0",
  "private": true,
  "description": "LinkPilot 프리미엄 명언 카드 — 매일 아침 무인 친구톡 발송 (GitHub Actions + Solapi)",
  "main": "send-morning-card.js",
  "scripts": {
    "send": "node send-morning-card.js",
    "test": "node --test test/*.test.js im-agent/test/*.test.js",
    "alert:dry": "ALERT_DRY_RUN=1 ALERT_WORKFLOW=morning-brief ALERT_RUN_URL=https://github.com/findKTH0415/linkpilot-cron/actions/runs/0 node alert-failure.js",
    "im": "node im-agent/cli.js",
    "im:demo": "IM_AGENT_OFFLINE=1 node im-agent/cli.js demo",
    "im:smoke": "node im-agent/tools/smoke-public-data.js"
  },
  "dependencies": {
    "solapi": "^5.5.1",
    "@napi-rs/canvas": "^0.1.65"
  }
}
