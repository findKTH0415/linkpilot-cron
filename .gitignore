node_modules/
package-lock.json
.DS_Store
.env

# IM Agent 프로젝트 데이터룸 — 실제 딜 자료가 들어가므로 절대 커밋하지 않는다
im-projects/

# 미리보기는 im-projects 스냅샷에서 생성한다 (npm run im:preview)
im-agent/ui/vanilla/preview.html

# 화면 4개를 묶은 미리보기 — 소스에서 언제든 다시 만든다 (npm run im:screens).
# 커밋하면 소스와 갈리고, 갈린 것을 아무도 눈치채지 못한다
im-agent/ui/platform/preview.html

# 브라우저 검증 시 생기는 DOM 덤프
v-*.html

# 결과 미리보기 — 표본 딜 IM 본문이 통째로 들어간다. 필요할 때 npm run im:result 로 만든다
im-agent/ui/platform/result.html
