# .env.example — 이 파일을 `.env` 로 복사해 값을 채운다.
#
#   cp .env.example .env
#   chmod 600 .env
#
# ★ `.env` 는 .gitignore 에 있다. 이 예시 파일에는 **값을 절대 넣지 않는다.**
# ★ 셸이나 GitHub Secrets 에 이미 있는 값이 이 파일보다 세다 (core/env.js).
# ★ 값에 꺾쇠 < > 나 따옴표를 남기지 않는다 — 인증만 실패하고 원인이 안 보인다.

# ── 공공데이터 ────────────────────────────────────────────
# VWorld (vworld.kr) — 지오코딩·지적도·용도지역·공시지가. UUID 형식.
VWORLD_KEY=

# VWorld 콘솔의 **서비스URL 을 글자 그대로** (스킴·경로 포함).
# 서버 호출에는 Referer 가 없어 이 값을 직접 넘겨야 한다. 없으면 키가 맞아도 거부된다.
# ★ 호스트만 남기면 ned/* 계열이 **간헐적으로** 거부한다 (실측 5회 중 2회).
VWORLD_DOMAIN=

# 공공데이터포털 (data.go.kr) — 실거래가·건축물대장.
# ★ 마이페이지 › 인증키의 **Decoding(일반)** 쪽. Encoding 쪽(%2F·%3D 포함)은 실패한다.
DATA_GO_KR_KEY=

# ── 기상청 API허브 (apihub.kma.go.kr) ─────────────────────
# data.go.kr 과 **별개 시스템·별개 키**다. 태양광 딜의 일사량·일조시간 조회용.
# ★ 키 첫 글자가 대문자 I 인지 소문자 l 인지 화면 글꼴로 구분되지 않는다.
#   틀리면 401 만 돌아오고 원인이 안 보인다 — 복사해서 넣는다.
# 필요한 활용신청: 지상관측데이터 일통계(sun_sfc_day) · 지점정보(stn_inf)
KMA_APIHUB_KEY=

# 관측지점을 직접 지정한다 (선택). 지점정보(stn_inf) 활용신청 승인 전에는
# 좌표→관측소 자동 선택이 막히므로 그때 쓴다. 예: 108(서울) · 159(부산)
# ★ 지정하면 부지와의 거리를 알 수 없어 출처에 '거리 미상' 으로 남는다.
KMA_STN=

# ── 한국부동산원 R-ONE (reb.or.kr) ────────────────────────
# 위 둘과 **또 다른 별개 키**다. reb.or.kr 에서 따로 발급받는다.
# data.go.kr 키를 넣으면 ERROR-290 만 돌아온다.
# 쓰임: 지가변동률 → 개별공시지가(1/1 기준)의 시점수정 (08 Appraisal)
REB_API_KEY=

# ── 한국은행 ECOS (ecos.bok.or.kr) ────────────────────────
# 국고채·CD 금리. 차입금리의 **기준선**으로만 쓴다 — 스프레드는 딜마다 다르다.
# 생산자물가지수(제조 딜의 단가 시점수정)도 같은 키를 쓴다.
ECOS_API_KEY=

# ── 통계청 KOSIS 공유서비스 (kosis.kr) ────────────────────
# 위 키들과 **또 다른 별개 키**다. kosis.kr 에서 따로 신청·발급받는다.
# 쓰임: 제조 딜의 **가동률 대조** — 업종 평균과 견준다. 값을 채우지는 않는다.
#       (개별 공장의 가동률은 공적으로 나오지 않는다. 나오는 것은 업종 평균뿐이다)
# ★ 같은 조사에 **가동률지수(2020=100)** 와 **평균가동률(%)** 이 함께 있다.
#   섞으면 「가동률 102%」가 그럴듯하게 나온다 — 항목을 고를 때 단위를 본다.
KOSIS_API_KEY=

# ── 한전 전력데이터 개방포털 (bigdata.kepco.co.kr) ────────
# 위 키들과 **또 다른 별개 키**다. 공공데이터포털에 목록이 올라와 있어도
# 인증은 저쪽에서 한다 — **DATA_GO_KR_KEY 를 넣으면 인증만 실패한다.**
# 쓰임: 데이터센터·태양광·풍력 딜의 **계통 여유용량 대조**.
#       수전용량은 딜이 말하는 대로 들어오는데, 계통이 받아 주는지는 별개다.
# ★ **변전소 거리는 어느 키로도 안 나온다.** 한전이 변전소 좌표를 국가중요시설
#   사유로 비식별 처리한다. 공개 범위는 행정구역 단위 「공급가능 변전소
#   있음/없음」까지다 — 거리는 지사 사전검토 회신을 사람이 받아 적는다.
# ★ 여유용량은 **조회 시점 스냅샷**이다. 접속 대기열이 있어 여유가 곧
#   접속 가능을 뜻하지 않는다.
KEPCO_BIGDATA_KEY=

# ── 한국건설기술연구원 KICT (건설공사비) ─────────────────
# 〈2026-08-25 사장님이 넣으심 — 「KICT_API_KEY 넣었어」〉
# 무엇에 쓰나: **공사비 시점수정**의 두 번째 출처. 지금은 한국은행 생산자물가
#   지수(ecos)만 쓰는데, 그것은 재료비 성격이고 **건설공사비지수**는 노무·경비를
#   포함한다 — 공사비 대조에는 이쪽이 결이 맞다.
# ★★ **어느 서비스의 키인지 아직 확정 못 했다** (등록부 D-106). KICT 는 공사비원가
#   관리센터(표준품셈·표준시장단가)와 건설공사비지수를 함께 내는데, 각각 발급 경로가
#   다르다. 엔드포인트가 확정되기 전까지 커넥터는 **호출하지 않는다** — 엉뚱한 주소로
#   부르면 「키가 틀렸다」와 구분이 안 된다 (§4.2 와 같은 결).
# ★ 확정되면 KICT_API_BASE 로 주소만 바꾼다. 코드는 안 건드린다.
KICT_API_KEY=
KICT_API_BASE=

# ── 금융감독원 DART (opendart.fss.or.kr) ──────────────────
# 시행사가 실재하는 법인인지 **대조**한다. 값을 채우지는 않는다.
DART_API_KEY=

# ── Pexels (무료 이미지 — 표지·간지의 **참고 이미지**) ────
# pexels.com/api 에서 발급 (무료). Authorization 헤더로 나간다.
# ★ 한도가 낮다: 시간당 200회 · 월 20,000회 (data.go.kr 의 1/50).
# ★ 여기서 받은 사진은 **이 사업의 현장이 아니다.** 09_IM/images/stock/ 에만
#   두고, 받은 자료(02_Source_Data)·지적선 그림(04_Property)과 섞지 않는다.
PEXELS_API_KEY=

# ── 선택 ──────────────────────────────────────────────────
# 02 Extraction 보완 · 06 Writer 문장. 없으면 규칙 기반만 동작한다.
GEMINI_API_KEY=

# ── Rhino.Compute (자체 호스팅 — 매스 스터디) ─────────────
# ★ **공공 API 가 아니다.** 우리가 세운 서버 주소다.
# ★ Compute 소프트웨어는 오픈소스지만 **그 서버에 Rhino 라이선스가 필요하다.**
#   무료가 아니다 (등록부 D-38). 없으면 매스 스터디만 건너뛴다.
# ★ 결과는 **생성물**이라 fact 로 등록하지 않는다 — 사람이 확인하고 채택한다.
RHINO_COMPUTE_URL=
# 서버에 접근키를 걸었으면 넣는다. 안 걸었으면 비워 둔다.
RHINO_COMPUTE_KEY=

# ── 저장소 연결 — 「연결해서 쓰기」 (2026-08-20) ───────────
#
# ★★ 콘솔에서 앱을 등록하고 **그 앱의 공개 식별자(client id)** 만 넣는다.
#   client secret 은 여기 넣지 않는다 — 넣어야 한다면 그 방식이 틀린 것이다
#   (아래 각 항목의 범위 설정을 지키면 secret 없이 동작한다).
#
# ★★ 범위를 넓게 잡으면 **되돌리기 어렵다.** 각 줄의 설정을 그대로 지킨다 —
#   이 값들은 connectors/storage.js 의 SCOPES 와 대조된다 (checkScope).
# ★ 없으면 그 제공자만 「아직 열려 있지 않습니다」로 뜬다. 지어내지 않는다.

# ── Dropbox ──
# 콘솔: 앱 등록 화면에서 Access type = App folder 를 고른다. Full Dropbox 로 만들면 되돌릴 수 없고 앱을 다시 만들어야 한다.
# 허용 범위: files.metadata.read · files.content.read
DROPBOX_APP_KEY=

# ── Box ──
# 콘솔: 서비스 계정을 그 폴더에만 협업자(Viewer) 로 초대한다. 기업 계정은 관리자 승인 범위도 폴더 단위로 좁힌다.
# 허용 범위: base_explorer · item_download
# 절대 요청하지 않는다: root_readwrite · root_readonly
BOX_CLIENT_ID=

# ── Google Drive ──
# 콘솔: `drive.file` 만 요청한다 — 사용자가 피커로 고른 것만 보인다.
# 허용 범위: https://www.googleapis.com/auth/drive.file
# 절대 요청하지 않는다: https://www.googleapis.com/auth/drive · https://www.googleapis.com/auth/drive.readonly · https://www.googleapis.com/auth/drive.metadata.readonly
GOOGLE_CLIENT_ID=

# ── OneDrive · SharePoint ──
# 콘솔: `Files.Read.Selected` 만 요청한다. `Files.Read.All` 은 조직 드라이브 전체다.
# 허용 범위: Files.Read.Selected · offline_access
# 절대 요청하지 않는다: Files.Read.All · Files.ReadWrite.All · Sites.Read.All · Sites.ReadWrite.All
MS_CLIENT_ID=
