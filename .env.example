# .env.example — 이 파일을 `.env` 로 복사해 값을 채운다.
#
#   cp .env.example .env
#   chmod 600 .env
#
# ★ `.env` 는 .gitignore 에 있다. 이 예시 파일에는 **값을 절대 넣지 않는다.**
# ★ 셸이나 GitHub Secrets 에 이미 있는 값이 이 파일보다 세다 (core/env.js).
# ★ 값에 꺾쇠 < > 나 따옴표를 남기지 않는다 — 인증만 실패하고 원인이 안 보인다.

# ── 공공데이터 ────────────────────────────────────────────
# VWorld (vworld.kr) — 지오코딩·지적도·용도지역·공시지가. UUID 형식.
VWORLD_KEY=

# VWorld 콘솔의 **서비스URL 을 글자 그대로** (스킴·경로 포함).
# 서버 호출에는 Referer 가 없어 이 값을 직접 넘겨야 한다. 없으면 키가 맞아도 거부된다.
# ★ 호스트만 남기면 ned/* 계열이 **간헐적으로** 거부한다 (실측 5회 중 2회).
VWORLD_DOMAIN=

# 공공데이터포털 (data.go.kr) — 실거래가·건축물대장.
# ★ 마이페이지 › 인증키의 **Decoding(일반)** 쪽. Encoding 쪽(%2F·%3D 포함)은 실패한다.
DATA_GO_KR_KEY=

# ── 기상청 API허브 (apihub.kma.go.kr) ─────────────────────
# data.go.kr 과 **별개 시스템·별개 키**다. 태양광 딜의 일사량·일조시간 조회용.
# ★ 키 첫 글자가 대문자 I 인지 소문자 l 인지 화면 글꼴로 구분되지 않는다.
#   틀리면 401 만 돌아오고 원인이 안 보인다 — 복사해서 넣는다.
# 필요한 활용신청: 지상관측데이터 일통계(sun_sfc_day) · 지점정보(stn_inf)
KMA_APIHUB_KEY=

# 관측지점을 직접 지정한다 (선택). 지점정보(stn_inf) 활용신청 승인 전에는
# 좌표→관측소 자동 선택이 막히므로 그때 쓴다. 예: 108(서울) · 159(부산)
# ★ 지정하면 부지와의 거리를 알 수 없어 출처에 '거리 미상' 으로 남는다.
KMA_STN=

# ── 한국부동산원 R-ONE (reb.or.kr) ────────────────────────
# 위 둘과 **또 다른 별개 키**다. reb.or.kr 에서 따로 발급받는다.
# data.go.kr 키를 넣으면 ERROR-290 만 돌아온다.
# 쓰임: 지가변동률 → 개별공시지가(1/1 기준)의 시점수정 (08 Appraisal)
REB_API_KEY=

# ── 한국은행 ECOS (ecos.bok.or.kr) ────────────────────────
# 국고채·CD 금리. 차입금리의 **기준선**으로만 쓴다 — 스프레드는 딜마다 다르다.
ECOS_API_KEY=

# ── 금융감독원 DART (opendart.fss.or.kr) ──────────────────
# 시행사가 실재하는 법인인지 **대조**한다. 값을 채우지는 않는다.
DART_API_KEY=

# ── 선택 ──────────────────────────────────────────────────
# 02 Extraction 보완 · 06 Writer 문장. 없으면 규칙 기반만 동작한다.
GEMINI_API_KEY=
